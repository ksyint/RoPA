{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study",
  "type": "object",
  "required": [
    "format",
    "root",
    "runs"
  ],
  "properties": {
    "format": {
      "const": 2
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "config",
          "config_sha256",
          "manifest",
          "manifest_sha256",
          "checkpoint",
          "checkpoint_sha256",
          "seed",
          "output",
          "command"
        ],
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifest_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "checkpoint": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoint_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-f0-9]{64}$"
          },
          "seed": {
            "type": "integer"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
